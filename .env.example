# Questionable Intel — environment configuration. Copy to `.env` for Docker Compose,
# or export the variables in your shell when running `python3 app.py`.
# Every value has a safe default baked into the app; only set what you need.

# Bind address + port (LAN-first: 0.0.0.0 exposes to the local network only).
TRIVIA_PORT=8130
TRIVIA_HOST=0.0.0.0

# Where the single SQLite file lives. Self-contained; deleting it resets the app.
# (Only used when running `python3 app.py` directly. In Docker the app always
# writes to /data inside the container; see TRIVIA_DATA_MOUNT below.)
TRIVIA_DATA_DIR=./data

# Docker only: where /data comes from. The default is a Docker-managed named
# volume (`trivia-data`), which works with no setup. Set this to ./data to keep
# the database in a host directory instead, for easy backup or inspection. That
# directory must be writable by the container's non-root user (uid 10001):
#   mkdir data && sudo chown 10001:10001 data
# Switching an existing install between the two starts on an empty database.
# TRIVIA_DATA_MOUNT=./data

# Docker only: image to run. Defaults to the published ghcr.io/mknerr/questionable-intel:latest.
# TRIVIA_IMAGE=ghcr.io/mknerr/questionable-intel:latest

# AI question generation. The default provider is DeepSeek
# (https://api.deepseek.com, model deepseek-flash). The one thing you need to
# set is your API key from platform.deepseek.com:
TRIVIA_LLM_API_KEY=
# Without a key the app still runs, and pasted or imported questions still
# work; only AI generation is unavailable (the host sees a clear message).
#
# These are defaults only: the host console's "AI settings" panel saves
# overrides in the database, and console > env > built-in default.
#
# To use a local Ollama instead, uncomment both lines (no key needed):
# TRIVIA_LLM_BASE=http://host.docker.internal:11434/v1
# TRIVIA_LLM_MODEL=qwen3.5:9b

# Unlocks the host-management APIs and console (game create/select/delete, round
# library, game configuration). Use at least 16 characters — management stays
# LOCKED (403) until this is set to >= 16 chars. Typed into the console per page
# session, sent as the X-Admin-Token header, never stored by the browser.
TRIVIA_ADMIN_TOKEN=

# Public base URL for join links and QR codes (e.g. https://trivia.example.com).
# When set, the stage QR/join link uses its normalized origin (scheme + host),
# so a public HTTPS deployment scans to the right address. Leave unset for
# direct-LAN play, where links use the request Host (http://<lan-ip>:port).
# TRIVIA_PUBLIC_BASE_URL=https://trivia.example.com

# Trust X-Forwarded-For only from this reverse-proxy IP (e.g. Nginx Proxy Manager). Leave
# empty when phones reach the app directly — behind a proxy, set it to the
# proxy's IP so per-phone rate limits key on the real client, not the proxy.
# TRIVIA_TRUSTED_PROXIES=192.168.1.2
